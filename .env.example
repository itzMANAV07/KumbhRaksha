# Copy this file to .env and fill in the values.
# Never commit .env to git.

# Required for M7 (Telegram adapter)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=some_random_string_32_chars

# Optional - falls back to keyword-only rules if absent
GEMINI_API_KEY=

# Optional overrides
DATABASE_URL=sqlite+aiosqlite:///./kumbh.db
SIM_TICK_SECONDS=5
ALERT_COOLDOWN_MINUTES=10
DASHBOARD_URL=http://localhost:5173
